From 83bfb76033a6a21919a44ff79942fe6c4efdec04 Mon Sep 17 00:00:00 2001
From: Kirill Mitrofanov <kmitrqq@gmail.com>
Date: Sat, 17 Oct 2026 12:43:38 +0300
Subject: [PATCH 05/12] dt-bindings: reset: qcom,aoss-reset: add X1E80100

Add X1E80100, whose AOSS_CC_RST_CTL block also restarts the Turing
(CDSP) subsystem, and an ID for that restart.

Assisted-by: Claude Opus 5.5
---
 Documentation/devicetree/bindings/reset/qcom,aoss-reset.yaml | 4 ++++
 include/dt-bindings/reset/qcom,sdm845-aoss.h                 | 1 +
 2 files changed, 5 insertions(+)

diff --git a/Documentation/devicetree/bindings/reset/qcom,aoss-reset.yaml b/Documentation/devicetree/bindings/reset/qcom,aoss-reset.yaml
index 24beb712b56d..4afda6cdd2a6 100644
--- a/Documentation/devicetree/bindings/reset/qcom,aoss-reset.yaml
+++ b/Documentation/devicetree/bindings/reset/qcom,aoss-reset.yaml
@@ -30,6 +30,10 @@ properties:
         items:
           - const: qcom,sdm845-aoss-cc
 
+      - description: on X1E80100 SoCs the following compatibles must be specified
+        items:
+          - const: qcom,x1e80100-aoss-cc
+
   reg:
     maxItems: 1
 
diff --git a/include/dt-bindings/reset/qcom,sdm845-aoss.h b/include/dt-bindings/reset/qcom,sdm845-aoss.h
index 476c5fc873b6..dbfdfc8cac61 100644
--- a/include/dt-bindings/reset/qcom,sdm845-aoss.h
+++ b/include/dt-bindings/reset/qcom,sdm845-aoss.h
@@ -13,5 +13,6 @@
 #define AOSS_CC_DISPSS_RESTART	4
 #define AOSS_CC_WCSS_RESTART	5
 #define AOSS_CC_LPASS_RESTART	6
+#define AOSS_CC_TURING_RESTART	7
 
 #endif
