From ab09ed89d247242f2b8448f8f5dab3f324693bed Mon Sep 17 00:00:00 2001
From: Kirill Mitrofanov <kmitrqq@gmail.com>
Date: Fri, 16 Oct 2026 20:31:39 +0300
Subject: [PATCH 5/5] arm64: dts: qcom: x1-el2: start ADSP and CDSP from Linux

At EL2 there is no hypervisor to set up the DSPs around TZ PAS, so let qcom_q6v5_adsp
start them without PAS. The ADSP streams stay in bypass (no iommus), the CDSP keeps
its stream 0x0c00 in a Linux IOMMU domain.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 arch/arm64/boot/dts/qcom/x1-el2.dtso | 9 ++++++++-
 1 file changed, 8 insertions(+), 1 deletion(-)

diff --git a/arch/arm64/boot/dts/qcom/x1-el2.dtso b/arch/arm64/boot/dts/qcom/x1-el2.dtso
index d05ffb7c15e7..f207f08a32e1 100644
--- a/arch/arm64/boot/dts/qcom/x1-el2.dtso
+++ b/arch/arm64/boot/dts/qcom/x1-el2.dtso
@@ -68,10 +68,17 @@ &pcie_smmu {
 };
 
 &remoteproc_adsp {
-	iommus = <&apps_smmu 0x1000 0x80>;
+	/*
+	 * Started by qcom_q6v5_adsp without TZ PAS. No iommus: the ADSP streams stay in
+	 * bypass as with the hypervisor; a Linux domain with only the carveouts mapped
+	 * makes the ADSP fault on its peripheral accesses.
+	 */
+	compatible = "qcom,x1e80100-adsp-pil";
 };
 
 &remoteproc_cdsp {
+	/* Started by qcom_q6v5_adsp without TZ PAS */
+	compatible = "qcom,x1e80100-cdsp-pil";
 	iommus = <&apps_smmu 0x0c00 0x0>;
 };
 
