From abe3e08795567db17868789c2b7fe295dc85d048 Mon Sep 17 00:00:00 2001
From: Kirill Mitrofanov <kmitrqq@gmail.com>
Date: Sat, 17 Oct 2026 12:43:38 +0300
Subject: [PATCH 07/12] dt-bindings: remoteproc: add X1E80100 ADSP and CDSP
 without TZ PAS

Linux at EL2 on X1E80100 has no hypervisor to set the DSPs up and starts
them itself through the QDSP6SS boot FSM, like qcom,sc7280-adsp-pil.
Describe the two DSPs for that case: both carry a main and a DTB image,
and take the PDC and AOSS resets and the TCSR halt registers.

Assisted-by: Claude Opus 5.5
---
 .../remoteproc/qcom,x1e80100-adsp-pil.yaml    | 204 ++++++++++++++++++
 1 file changed, 204 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/remoteproc/qcom,x1e80100-adsp-pil.yaml

diff --git a/Documentation/devicetree/bindings/remoteproc/qcom,x1e80100-adsp-pil.yaml b/Documentation/devicetree/bindings/remoteproc/qcom,x1e80100-adsp-pil.yaml
new file mode 100644
index 000000000000..74c67cb0ff80
--- /dev/null
+++ b/Documentation/devicetree/bindings/remoteproc/qcom,x1e80100-adsp-pil.yaml
@@ -0,0 +1,204 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/remoteproc/qcom,x1e80100-adsp-pil.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Qualcomm X1E80100 ADSP and CDSP Peripheral Image Loader without TZ PAS
+
+maintainers:
+  - Kirill Mitrofanov <kmitrqq@gmail.com>
+
+description:
+  The ADSP and CDSP of X1E80100 when Linux runs at EL2 without the Qualcomm
+  hypervisor. Linux loads the main and DTB images itself and starts the
+  Hexagon core through the QDSP6SS boot FSM, the way qcom,sc7280-adsp-pil
+  does, instead of asking TrustZone to authenticate and start it.
+
+properties:
+  compatible:
+    enum:
+      - qcom,x1e80100-adsp-pil
+      - qcom,x1e80100-cdsp-pil
+
+  reg:
+    items:
+      - description: qdsp6ss register
+
+  iommus:
+    maxItems: 1
+
+  interrupts:
+    maxItems: 5
+
+  interrupt-names:
+    items:
+      - const: wdog
+      - const: fatal
+      - const: ready
+      - const: handover
+      - const: stop-ack
+
+  clocks:
+    items:
+      - description: XO clock
+
+  clock-names:
+    items:
+      - const: xo
+
+  power-domains:
+    minItems: 2
+    maxItems: 3
+
+  power-domain-names:
+    minItems: 2
+    maxItems: 3
+
+  interconnects:
+    maxItems: 1
+
+  resets:
+    items:
+      - description: PDC sync reset of the subsystem
+      - description: AOSS restart of the subsystem
+
+  reset-names:
+    items:
+      - const: pdc_sync
+      - const: restart
+
+  memory-region:
+    items:
+      - description: Main image carveout
+      - description: DTB image carveout
+
+  firmware-name:
+    items:
+      - description: Main image
+      - description: DTB image
+
+  qcom,halt-regs:
+    $ref: /schemas/types.yaml#/definitions/phandle-array
+    description:
+      Phandle to the TCSR syscon with the halt request/ack registers of the
+      subsystem, and their offset in it.
+    items:
+      - items:
+          - description: phandle to the TCSR syscon
+          - description: offset to the halt registers
+
+  qcom,qmp:
+    $ref: /schemas/types.yaml#/definitions/phandle
+    description: Reference to the AOSS side-channel message RAM.
+
+  qcom,smem-states:
+    $ref: /schemas/types.yaml#/definitions/phandle-array
+    description: States used by the AP to signal the Hexagon core
+    items:
+      - description: Stop the DSP
+        items:
+          - description: Phandle to the Shared Memory Point 2 Point device
+              handling the communication with a remote processor
+          - description: Single bit index to toggle in the value sent to
+              the remote processor
+            maximum: 32
+
+  qcom,smem-state-names:
+    description: The names of the state bits used for SMP2P output
+    const: stop
+
+  glink-edge:
+    $ref: qcom,glink-edge.yaml#
+    type: object
+    unevaluatedProperties: true
+    description:
+      Qualcomm G-Link subnode which represents communication edge, channels
+      and devices related to the DSP.
+
+required:
+  - compatible
+  - reg
+  - interrupts
+  - interrupt-names
+  - clocks
+  - clock-names
+  - power-domains
+  - power-domain-names
+  - resets
+  - reset-names
+  - qcom,halt-regs
+  - memory-region
+  - qcom,smem-states
+  - qcom,smem-state-names
+
+allOf:
+  - if:
+      properties:
+        compatible:
+          const: qcom,x1e80100-adsp-pil
+    then:
+      properties:
+        power-domains:
+          maxItems: 2
+        power-domain-names:
+          items:
+            - const: lcx
+            - const: lmx
+        iommus: false
+    else:
+      properties:
+        power-domains:
+          minItems: 3
+        power-domain-names:
+          items:
+            - const: cx
+            - const: mxc
+            - const: nsp
+      required:
+        - iommus
+
+additionalProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/clock/qcom,rpmh.h>
+    #include <dt-bindings/interrupt-controller/arm-gic.h>
+    #include <dt-bindings/interrupt-controller/irq.h>
+    #include <dt-bindings/power/qcom,rpmhpd.h>
+    #include <dt-bindings/reset/qcom,sdm845-aoss.h>
+    #include <dt-bindings/reset/qcom,sdm845-pdc.h>
+
+    remoteproc@32300000 {
+        compatible = "qcom,x1e80100-cdsp-pil";
+        reg = <0x32300000 0x10000>;
+
+        interrupts-extended = <&intc GIC_SPI 578 IRQ_TYPE_EDGE_RISING>,
+                              <&smp2p_cdsp_in 0 IRQ_TYPE_EDGE_RISING>,
+                              <&smp2p_cdsp_in 1 IRQ_TYPE_EDGE_RISING>,
+                              <&smp2p_cdsp_in 2 IRQ_TYPE_EDGE_RISING>,
+                              <&smp2p_cdsp_in 3 IRQ_TYPE_EDGE_RISING>;
+        interrupt-names = "wdog", "fatal", "ready", "handover", "stop-ack";
+
+        clocks = <&rpmhcc RPMH_CXO_CLK>;
+        clock-names = "xo";
+
+        power-domains = <&rpmhpd RPMHPD_CX>,
+                        <&rpmhpd RPMHPD_MXC>,
+                        <&rpmhpd RPMHPD_NSP>;
+        power-domain-names = "cx", "mxc", "nsp";
+
+        iommus = <&apps_smmu 0x0c00 0x0>;
+
+        resets = <&pdc_reset PDC_COMPUTE_SYNC_RESET>,
+                 <&aoss_reset AOSS_CC_TURING_RESTART>;
+        reset-names = "pdc_sync", "restart";
+        qcom,halt-regs = <&tcsr_halt 0x14000>;
+
+        memory-region = <&cdsp_mem>, <&q6_cdsp_dtb_mem>;
+        firmware-name = "qcom/x1e80100/cdsp.mbn", "qcom/x1e80100/cdsp_dtb.mbn";
+
+        qcom,qmp = <&aoss_qmp>;
+        qcom,smem-states = <&smp2p_cdsp_out 0>;
+        qcom,smem-state-names = "stop";
+    };
-- 
