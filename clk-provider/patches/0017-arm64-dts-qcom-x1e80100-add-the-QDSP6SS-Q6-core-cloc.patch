From a68972b03e43f7ffa0a40f9c62f14d04be5dace6 Mon Sep 17 00:00:00 2001
From: Kirill Mitrofanov <kmitrqq@gmail.com>
Date: Sat, 17 Oct 2026 12:59:43 +0300
Subject: [PATCH 17/17] arm64: dts: qcom: x1e80100: add the QDSP6SS Q6 core
 clock controllers

Add the ADSP and CDSP Q6SS clock controllers, disabled since the
hypervisor programs these clocks, and enable them in the EL2 overlay as
the core clock of both DSPs.

The Q6 PLL configuration assumes a 19.2 MHz reference, so feed both
from bi_tcxo_ao_div2: it has that rate, and the active-only vote does
not keep XO on while the CPUs sleep.

Assisted-by: Claude Opus 5.5
---
 arch/arm64/boot/dts/qcom/hamoa.dtsi  | 16 ++++++++++++++++
 arch/arm64/boot/dts/qcom/x1-el2.dtso | 16 ++++++++++++++++
 2 files changed, 32 insertions(+)

diff --git a/arch/arm64/boot/dts/qcom/hamoa.dtsi b/arch/arm64/boot/dts/qcom/hamoa.dtsi
index 8f08642351f9..041826949648 100644
--- a/arch/arm64/boot/dts/qcom/hamoa.dtsi
+++ b/arch/arm64/boot/dts/qcom/hamoa.dtsi
@@ -4320,6 +4320,14 @@ nsp_noc: interconnect@320c0000 {
 			#interconnect-cells = <2>;
 		};
 
+		adsp_q6sscc: clock-controller@6840000 {
+			compatible = "qcom,x1e80100-adsp-q6sscc";
+			reg = <0x0 0x06840000 0x0 0x10000>;
+			clocks = <&bi_tcxo_ao_div2>;
+			#clock-cells = <1>;
+			status = "disabled"; /* Programmed by the hypervisor */
+		};
+
 		remoteproc_adsp: remoteproc@6800000 {
 			compatible = "qcom,x1e80100-adsp-pas";
 			reg = <0x0 0x06800000 0x0 0x10000>;
@@ -9480,6 +9488,14 @@ system-cache-controller@25000000 {
 			interrupts = <GIC_SPI 266 IRQ_TYPE_LEVEL_HIGH>;
 		};
 
+		cdsp_q6sscc: clock-controller@32340000 {
+			compatible = "qcom,x1e80100-cdsp-q6sscc";
+			reg = <0x0 0x32340000 0x0 0x10000>;
+			clocks = <&bi_tcxo_ao_div2>;
+			#clock-cells = <1>;
+			status = "disabled"; /* Programmed by the hypervisor */
+		};
+
 		remoteproc_cdsp: remoteproc@32300000 {
 			compatible = "qcom,x1e80100-cdsp-pas";
 			reg = <0x0 0x32300000 0x0 0x10000>;
diff --git a/arch/arm64/boot/dts/qcom/x1-el2.dtso b/arch/arm64/boot/dts/qcom/x1-el2.dtso
index 099e9bb1d0ac..6764dc621e11 100644
--- a/arch/arm64/boot/dts/qcom/x1-el2.dtso
+++ b/arch/arm64/boot/dts/qcom/x1-el2.dtso
@@ -1,4 +1,6 @@
 // SPDX-License-Identifier: BSD-3-Clause
+#include <dt-bindings/clock/qcom,rpmh.h>
+#include <dt-bindings/clock/qcom,x1e80100-q6sscc.h>
 #include <dt-bindings/firmware/qcom,scm.h>
 #include <dt-bindings/reset/qcom,sdm845-aoss.h>
 #include <dt-bindings/reset/qcom,sdm845-pdc.h>
@@ -76,6 +78,9 @@ &remoteproc_adsp {
 	 * makes the ADSP fault on its peripheral accesses.
 	 */
 	compatible = "qcom,x1e80100-adsp-pil";
+	clocks = <&rpmhcc RPMH_CXO_CLK>,
+		 <&adsp_q6sscc Q6SSCC_Q6_CORE_CLK_SRC>;
+	clock-names = "xo", "core";
 	resets = <&pdc_reset PDC_AUDIO_SYNC_RESET>,
 		 <&aoss_reset AOSS_CC_LPASS_RESTART>;
 	reset-names = "pdc_sync", "restart";
@@ -85,6 +90,9 @@ &remoteproc_adsp {
 &remoteproc_cdsp {
 	/* Started by qcom_q6v5_adsp without TZ PAS */
 	compatible = "qcom,x1e80100-cdsp-pil";
+	clocks = <&rpmhcc RPMH_CXO_CLK>,
+		 <&cdsp_q6sscc Q6SSCC_Q6_CORE_CLK_SRC>;
+	clock-names = "xo", "core";
 	iommus = <&apps_smmu 0x0c00 0x0>;
 	resets = <&pdc_reset PDC_COMPUTE_SYNC_RESET>,
 		 <&aoss_reset AOSS_CC_TURING_RESTART>;
@@ -96,6 +104,14 @@ &pdc_reset {
 	status = "okay";
 };
 
+&adsp_q6sscc {
+	status = "okay";
+};
+
+&cdsp_q6sscc {
+	status = "okay";
+};
+
 &aoss_reset {
 	status = "okay";
 };
-- 
